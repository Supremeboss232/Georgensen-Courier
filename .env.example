# ==============================================================================
# Georgensen Courier Platform - Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application
PROJECT_NAME="Georgensen Courier Platform"
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=replace-with-32-byte-cryptographic-secret

# Database (PostgreSQL / Supabase in production, or SQLite for local development)
DATABASE_URL=sqlite:///./georgensen_courier.db

# Payment Rails (Payrail Primary / Stripe Compatible)
PAYRAIL_SECRET_KEY=sk_live_your_payrail_key_here
PAYRAIL_API_URL=https://api.payrail.co/v1
PAYRAIL_WEBHOOK_SECRET=whsec_your_payrail_webhook_secret

# Redis & Celery Background Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email & Support Notifications
SUPPORT_EMAIL=support@georgensencourier.com
FROM_EMAIL=noreply@georgensencourier.com
SENDGRID_API_KEY=

# Optional Supabase Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
